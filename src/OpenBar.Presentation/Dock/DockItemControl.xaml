<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenBar.Presentation.Dock.DockItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dock="using:OpenBar.Presentation.Dock"
    mc:Ignorable="d">
    <UserControl.Resources>
        <dock:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid
        x:Name="ItemRoot"
        Width="{Binding IconSize}"
        Height="{Binding IconSize}"
        Background="Transparent"
        RenderTransformOrigin="0.5,0.5"
        ToolTipService.ToolTip="{Binding DisplayName}"
        AutomationProperties.Name="{Binding DisplayName}"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Border
            x:Name="HoverBackground"
            CornerRadius="12"
            Background="#26FFFFFF"
            Opacity="0" />

        <FontIcon
            Glyph="&#xE8A5;"
            FontSize="28"
            Opacity="0.55"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <Image
            Source="{Binding Icon}"
            Stretch="Uniform"
            Margin="4" />

        <Ellipse
            Width="5"
            Height="5"
            Fill="White"
            Opacity="0.9"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,1"
            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
